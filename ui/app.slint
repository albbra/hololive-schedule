import { Button, ScrollView } from "std-widgets.slint";

export struct StreamData {
    date: string,
    show-date: bool,
    name: string,
    time: string,
    link: string,
    pic: image,
    title: string,
    is-live: bool,
}

export component AppWindow inherits Window {
    in-out property <[StreamData]> streams;
    in-out property <bool>   loading;
    in-out property <string> error;
    in-out property <string> jp-time;

    callback refresh();
    callback open-link(string);

    title: "Hololive Schedule";
    preferred-width: 520px;
    preferred-height: 900px;
    min-width: 400px;
    min-height: 300px;
    background: #1a1a1a;

    VerticalLayout {
        padding: 14px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Hololive Schedule";
                color: #f0f0f0;
                font-size: 22px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: "⟳  Refresh";
                enabled: !root.loading;
                clicked => { root.refresh(); }
            }
        }

        Text {
            text: root.jp-time;
            color: #888;
            font-size: 12px;
        }

        Rectangle { height: 1px; background: #303030; }

        if root.loading && root.streams.length == 0: Text {
            text: "Fetching streams…";
            color: #aaa;
        }

        if root.error != "": Text {
            text: "⚠  " + root.error;
            color: #ff6b6b;
            wrap: word-wrap;
        }

        ScrollView {
            VerticalLayout {
                spacing: 2px;

                for stream in root.streams: VerticalLayout {
                    if stream.show-date: VerticalLayout {
                        padding-top: 14px;
                        padding-bottom: 6px;
                        Text {
                            text: stream.date;
                            color: #6af;
                            font-size: 20px;
                            font-weight: 700;
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        padding-top: 6px;
                        padding-bottom: 6px;

                        stream-thumb := Rectangle {
                            width: 216px;
                            height: 122px;
                            border-radius: 6px;
                            clip: true;
                            background: #2a2a2a;

                            if stream.pic.width > 0: Image {
                                source: stream.pic;
                                width: 100%;
                                height: 100%;
                            }

                            ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.open-link(stream.link); }
                            }
                            if ta.has-hover: Rectangle {
                                background: #ffffff14;
                            }
                        }

                        VerticalLayout {
                            padding-top: 14px;
                            spacing: 6px;

                            // Name + LIVE badge
                            HorizontalLayout {
                                spacing: 6px;
                                // no alignment: center here — the name keeps its own position

                                Text {
                                    text: stream.name;
                                    color: #f0f0f0;
                                    font-size: 16px;
                                    font-weight: 700;
                                    wrap: word-wrap;
                                }

                                if stream.is-live: Rectangle {
                                    background: #ff3b30;
                                    border-radius: 4px;

                                    // Lock the pill to a known height and shrink horizontally
                                    horizontal-stretch: 0;
                                    vertical-stretch: 0;
                                    min-height: 18px;
                                    max-height: 18px;

                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        alignment: center;      // centers the Text vertically

                                        Text {
                                            text: "LIVE";
                                            color: white;
                                            font-size: 11px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            Text {
                                text: stream.time;
                                color: #999;
                                font-size: 14px;
                            }

                            if stream.title != "": Text {
                                text: stream.title;
                                color: #bbb;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
}